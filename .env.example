# Opsional: isi jika Tesseract tidak terdeteksi otomatis.
# Windows contoh: TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# Linux contoh: TESSERACT_CMD=/usr/bin/tesseract

# Bahasa OCR. Pastikan file traineddata tersedia pada instalasi Tesseract.
TESSERACT_LANG=ind+eng

# Opsional: secret key Flask untuk deployment.
SECRET_KEY=ganti-dengan-string-acak
